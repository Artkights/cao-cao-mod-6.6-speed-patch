    CONTROL "6.6", IDC_FORCE_66, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 184, 171, 70, 16
    DEFPUSHBUTTON "强行注入…", IDOK, 174, 194, 70, 20
