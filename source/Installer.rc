#pragma code_page(65001)
#include <windows.h>
#include "ResourceIds.h"
#include "Version.rc"

IDI_DORO_WHITE ICON "Doro-white.ico"
IDR_INSTALL_PROXY RCDATA "Koeicda.dll"
IDR_INSTALL_PROXY65 RCDATA "Koeicda65.dll"
IDR_INSTALL_PROXY64 RCDATA "Koeicda64.dll"
IDR_INSTALL_GEAR RCDATA "GearNtKe.dll"
IDR_INSTALL_CONFIG RCDATA "pl_06.ini"
IDR_INSTALL_FEATURES RCDATA "features.ini"

#include "FeatureSelection.rc"

IDD_VERSION_SELECT DIALOGEX 0, 0, 315, 218
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择版本并确认安装"
FONT 9, "Microsoft YaHei UI", 400, 0, 134
BEGIN
    LTEXT "主程序布局或版本资源未确认，请明确选择实际引擎版本：", -1, 12, 12, 290, 25
    CONTROL "6.4", IDC_VERSION_64, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 24, 43, 72, 18
    CONTROL "6.5", IDC_VERSION_65, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 122, 43, 72, 18
    CONTROL "6.6", IDC_VERSION_66, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 220, 43, 72, 18
    LTEXT "", IDC_VERSION_NOTE, 12, 73, 291, 101
    DEFPUSHBUTTON "备份后按所选版本安装", IDOK, 100, 185, 139, 22
    PUSHBUTTON "取消", IDCANCEL, 246, 185, 57, 22
END
