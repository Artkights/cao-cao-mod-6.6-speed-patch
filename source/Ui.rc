#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "UiIds.h"
#include "ResourceIds.h"

IDI_DORO_WHITE ICON "Doro-white.ico"
IDR_UNINSTALL_WORKER RCDATA "UninstallWorker.exe"

IDD_SPEED DIALOGEX 0, 0, 408, 289
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "加速补丁"
FONT 9, "Microsoft YaHei UI", 400, 0, 134
BEGIN
    CONTROL "", IDC_PAGE_TAB, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 7, 7, 394, 247
    GROUPBOX "超级加速", IDC_GROUP_SUPER, 16, 30, 178, 117
    CONTROL "启用超级加速", IDC_SUPER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 43, 150, 12
    CONTROL "取消对话", IDC_SUPER_DIALOG, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 61, 150, 12
    CONTROL "取消地图文字", IDC_SUPER_MAPTEXT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 78, 150, 12
    CONTROL "取消延时指令", IDC_SUPER_DELAY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 95, 150, 12
    CONTROL "取消 R 动作", IDC_SUPER_R, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 112, 150, 12
    CONTROL "取消 S 动作 / 旁白", IDC_SUPER_S, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 129, 150, 12

    GROUPBOX "阶段加速", IDC_GROUP_PHASE, 202, 30, 190, 117
    CONTROL "启用阶段加速", IDC_PHASE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 212, 43, 169, 12
    CONTROL "我军阶段", IDC_PHASE_OWN, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 212, 63, 94, 12
    EDITTEXT IDC_PHASE_VALUE_OWN, 327, 60, 43, 17, ES_AUTOHSCROLL | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_SPIN_OWN, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT, 370, 60, 11, 17
    CONTROL "友军阶段", IDC_PHASE_FRIEND, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 212, 83, 94, 12
    EDITTEXT IDC_PHASE_VALUE_FRIEND, 327, 80, 43, 17, ES_AUTOHSCROLL | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_SPIN_FRIEND, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT, 370, 80, 11, 17
    CONTROL "敌军阶段", IDC_PHASE_ENEMY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 212, 103, 94, 12
    EDITTEXT IDC_PHASE_VALUE_ENEMY, 327, 100, 43, 17, ES_AUTOHSCROLL | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_SPIN_ENEMY, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT, 370, 100, 11, 17
    CONTROL "滚轮微调", IDC_WHEEL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 212, 123, 94, 12
    EDITTEXT IDC_WHEEL_STEP, 327, 120, 43, 17, ES_AUTOHSCROLL | ES_RIGHT | WS_TABSTOP
    CONTROL "", IDC_SPIN_WHEEL, "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_SETBUDDYINT, 370, 120, 11, 17

    GROUPBOX "齿轮加速", IDC_GROUP_GEAR, 16, 155, 376, 57
    CONTROL "启用齿轮加速", IDC_GEAR, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 170, 92, 12
    CONTROL "", IDC_GEAR_SLIDER, "msctls_trackbar32", TBS_AUTOTICKS | WS_TABSTOP, 123, 166, 158, 29
    PUSHBUTTON "−", IDC_GEAR_MINUS, 286, 167, 22, 20
    EDITTEXT IDC_GEAR_VALUE, 313, 168, 43, 18, ES_AUTOHSCROLL | ES_RIGHT | WS_TABSTOP
    PUSHBUTTON "+", IDC_GEAR_PLUS, 361, 167, 22, 20
    CONTROL "Ctrl 加速改 Shift", IDC_SHIFT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 26, 226, 194, 12

    LTEXT "超级加速", IDC_LABEL_HOTKEY_SUPER, 28, 47, 112, 12
    CONTROL "", IDC_HOTKEY_SUPER, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 154, 43, 220, 20
    LTEXT "阶段加速", IDC_LABEL_HOTKEY_PHASE, 28, 78, 112, 12
    CONTROL "", IDC_HOTKEY_PHASE, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 154, 74, 220, 20
    LTEXT "齿轮加速", IDC_LABEL_HOTKEY_GEAR, 28, 109, 112, 12
    CONTROL "", IDC_HOTKEY_GEAR, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 154, 105, 220, 20
    LTEXT "调大齿轮数值", IDC_LABEL_HOTKEY_PLUS, 28, 140, 112, 12
    CONTROL "", IDC_HOTKEY_PLUS, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 154, 136, 220, 20
    LTEXT "调小齿轮数值", IDC_LABEL_HOTKEY_MINUS, 28, 171, 112, 12
    CONTROL "", IDC_HOTKEY_MINUS, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 154, 167, 220, 20

    PUSHBUTTON "保存配置", IDC_SAVE, 266, 263, 64, 19
    PUSHBUTTON "关闭", IDCANCEL, 337, 263, 64, 19
END
