// Verified native target-iteration profiles. Every address is rebased separately;
// the stack locals differ even where 6.4 and 6.5 share a preferred VA.
bool ResolveReceivedLayout(const PeImage& image, ReceivedLayout& output) {
    output=ReceivedLayout();
    const bool v64=CompiledEngineProfile()==EngineProfileId::Ccz64;
    const bool v66=CompiledEngineProfile()==EngineProfileId::Ccz66;
    const uintptr_t delta=image.virtualBase-image.nt->OptionalHeader.ImageBase;
    auto at=[delta](uintptr_t p) { return p+delta; };
    auto bytes=[&](uintptr_t site,std::initializer_list<BYTE> data) {
        const BYTE* p=image.At(at(site),data.size());
        return p && !memcmp(p,data.begin(),data.size());
    };
    auto call=[&](uintptr_t site,uintptr_t target,ReceivedRole role,bool entry,int local,int index) {
        const BYTE* p=image.At(at(site),5);
        if (!p || CallTarget(image,p)!=at(target)) return false;
        output.calls.push_back({at(site),at(target),role,entry,local,index});return true;
    };
    auto verifyCall=[&](uintptr_t site,uintptr_t target) {
        const BYTE* p=image.At(at(site),5);return p && CallTarget(image,p)==at(target);
    };
    output.base=at(0x400000);
    output.physicalActions={at(0x40654A),at(v66 ? 0x4179AE : 0x4179AC)};
    output.strategyActions={at(v66 ? 0x4179DF : 0x4179DD),at(v64 ? 0x405BC8 : 0x41C0FE)};
    // PhysicalResult is already observed by the critical/combo bridge. Its new
    // entry stamp is recorded there without replacing the game's return slot.
    output.physical=(v64 ? bytes(0x405DE1,{0x55,0x8B,0xEC,0x83,0xEC,0x2C,0x89,0x4D,0xF4}) :
        bytes(0x405DE1,{0x55,0x8B,0xEC,0x83,0xEC,0x30,0x89,0x4D,0xF4})) &&
        bytes(0x405E25,{0x8A,0x54,0x08,0x10,0x80,0xFA,0xFF,0x0F,0x84,0x66,0x02,0,0,
            0x88,0x51,0x01,0x8A,0xCA}) &&
        bytes(0x4527FE,{0x55,0x8B,0xEC,0x51}) &&
        verifyCall(0x452802,0x405DE1) && verifyCall(0x406545,0x4527FE) &&
        verifyCall(v66 ? 0x4179A9 : 0x4179A7,0x4527FE) && call(0x405E37,0x4061F9,ReceivedPhysical,false,12,4);
    const size_t physicalCalls=output.calls.size();
    bool strategy=bytes(0x425627,{0x55,0x8B,0xEC,0x51,0xFF,0x75,0x0C,0xFF,0x75,0x08}) &&
        verifyCall(v66 ? 0x4179DA : 0x4179D8,0x425627) &&
        verifyCall(v64 ? 0x405BC3 : 0x41C0F9,0x425627);
    const uintptr_t damageOwner=v66 ? 0x423198 : 0x42314D;
    const uintptr_t mixedOwner=v66 ? 0x4231A8 : 0x42356E;
    // Owner stamps depend on these exact native frame/context locals. A valid
    // CALL destination alone cannot establish that stack contract.
    strategy=strategy && bytes(v66 ? 0x423230 : 0x42322C,{0x55,0x8B,0xEC,0x33,0xC0,0x50,0x51}) &&
        bytes(0x42427B,{0x55,0x8B,0xEC,0x6A,0,0x6A,0,0x51,0x8B,0x49,0x08}) &&
        bytes(v66 ? 0x4243C6 : 0x4243E4,{0x55,0x8B,0xEC,0x33,0xC0,0x50,0x51,0x83,0xEC,0x08}) &&
        (v66 ? (bytes(damageOwner,{0x55,0x8B,0xEC,0x6A,0x02,0x6A,0,0x6A,0}) &&
            bytes(mixedOwner,{0x55,0x8B,0xEC,0x33,0xD2,0x3B,0xC2}) &&
            bytes(0x423594,{0x55,0x8B,0xEC,0x51,0x50,0x6A,0,0x6A,0,0x83,0xEC,0x0C}) &&
            bytes(0x423AA1,{0x55,0x8B,0xEC,0x51,0x6A,0,0x51,0x6A,0x03})) :
            (bytes(damageOwner,{0x55,0x8B,0xEC,0x51,0x51,0x51}) &&
            bytes(mixedOwner,{0x55,0x8B,0xEC,0x51,0x83,0xEC,0x10}) &&
            bytes(0x423A9A,{0x55,0x8B,0xEC,0x51,0x83,0xEC,0x0C}))) &&
        bytes(v66 ? 0x4244E5 : (v64 ? 0x424505 : 0x424503),v64 ?
            std::initializer_list<BYTE>{0x55,0x8B,0xEC,0x51,0x6A,0,0x6A,0x02} :
            std::initializer_list<BYTE>{0x55,0x8B,0xEC,0x51,0x6A,0x02});
    strategy=strategy &&
        call(v66 ? 0x4256BC : 0x4256DC,damageOwner,ReceivedDamage,true,8,4) &&
        call(0x42575D,mixedOwner,ReceivedMixed,true,4,8) &&
        call(0x425737,v66 ? 0x423230 : 0x42322C,ReceivedState,true,8,4) &&
        call(0x425786,v66 ? 0x423AA1 : 0x423A9A,ReceivedSpecial,true,4,8) &&
        call(v66 ? 0x4256C9 : 0x4256E9,0x42427B,ReceivedAll,true,12,4) &&
        call(0x425767,v66 ? 0x4243C6 : 0x4243E4,ReceivedRandom,true,8,4) &&
        call(0x42595D,v66 ? 0x4244E5 : (v64 ? 0x424505 : 0x424503),ReceivedScatter,true,4,v64 ? 8 : 24);
    if (v66) {
        strategy=strategy && verifyCall(0x4231A1,0x4231C2) && verifyCall(0x4231BB,0x4231C2) &&
            call(0x4231E5,0x423594,ReceivedMixed,true,4,12) &&
            call(0x4235B6,0x4061F9,ReceivedMixed,false,4,12) &&
            bytes(0x4235A0,{0x8B,0x55,0xFC,0x8B,0x45,0xF4,0x8A,0x4C,0x10,0x0D,
                0x80,0xF9,0xFF,0x0F,0x84,0xA9,0,0,0,0x88,0x4A,0x0C});
    } else {
        strategy=strategy && call(0x42318C,0x4061F9,ReceivedDamage,false,8,4) &&
            call(0x4235BB,0x4061F9,ReceivedMixed,false,4,8) &&
            bytes(0x42317A,{0x8B,0x45,0xFC,0x8B,0x55,0xF8,0x8A,0x4C,0x10,0x0D,0x80,0xF9,0xFF}) &&
            bytes(0x4235A9,{0x8B,0x55,0xF8,0x8B,0x45,0xFC,0x8A,0x4C,0x10,0x0D,0x80,0xF9,0xFF});
    }
    strategy=strategy && call(v66 ? 0x42326D : 0x42326E,0x4061F9,ReceivedState,false,8,4) &&
        call(v66 ? 0x423ACF : 0x423AD2,0x4061F9,ReceivedSpecial,false,4,8) &&
        call(v66 ? 0x424323 : 0x424344,0x4061F9,ReceivedAll,false,12,4) &&
        call(v66 ? 0x4244CC : (v64 ? 0x4244EF : 0x4244EA),0x44DE9E,ReceivedRandom,false,8,4) &&
        call(v66 ? 0x424623 : 0x424624,0x40658F,ReceivedScatter,false,4,v64 ? 8 : 24) &&
        bytes(v66 ? 0x42461D : 0x42461E,v64 ?
            std::initializer_list<BYTE>{0xFE,0x45,0xF8,0x8B,0x4D,0xF4} :
            std::initializer_list<BYTE>{0xFE,0x45,0xE8,0x8B,0x4D,0xF8}) &&
        bytes(v66 ? 0x424434 : (v64 ? 0x424457 : 0x424452),{0x89,0x45,0xF4,0x8B,0x4D,0xF8,0x3C,0x01,0x77,0x49}) &&
        verifyCall(v66 ? 0x42442F : (v64 ? 0x424452 : 0x42444D),0x47FB13) &&
        bytes(v66 ? 0x42325B : 0x42325C,v66 ?
            std::initializer_list<BYTE>{0x8B,0x4D,0xFC,0x8B,0x55,0xF8,0x8A,0x4C,0x11,0x0D,0x80,0xF9,0xFF,0x74,0x47,0x88,0x4A,0x0C} :
            std::initializer_list<BYTE>{0x8B,0x4D,0xFC,0x8B,0x55,0xF8,0x8A,0x4C,0x11,0x0D,0x80,0xF9,0xFF,0x74,0x44,0x88,0x4A,0x0C}) &&
        bytes(v66 ? 0x423ABD : 0x423AC0,v66 ?
            std::initializer_list<BYTE>{0x8B,0x45,0xF8,0x8B,0x55,0xFC,0x8A,0x4C,0x10,0x0D,0x80,0xF9,0xFF,0x74,0x33,0x88,0x4A,0x0C} :
            std::initializer_list<BYTE>{0x8B,0x45,0xF8,0x8B,0x55,0xFC,0x8A,0x4C,0x10,0x0D,0x80,0xF9,0xFF,0x74,0x30,0x88,0x4A,0x0C}) &&
        bytes(v66 ? 0x424311 : 0x424332,v66 ?
            std::initializer_list<BYTE>{0x8B,0x45,0xFC,0x8B,0x55,0xF4,0x8A,0x4C,0x10,0x0D,0x80,0xF9,0xFF,0x74,0x48,0x88,0x4A,0x0C} :
            std::initializer_list<BYTE>{0x8B,0x45,0xFC,0x8B,0x55,0xF4,0x8A,0x4C,0x10,0x0D,0x80,0xF9,0xFF,0x74,0x45,0x88,0x4A,0x0C}) &&
        bytes(0x4785C6,{0x40,0x49,0x4A,0x4B,0x4C,0x48,0x57,0x50});
    // The random result's subtype is captured by the original RNG, including
    // branches which never execute the hit-test helper. Support is all-or-none.
    output.strategy=strategy;
    if (!strategy) output.calls.resize(physicalCalls);
    return output.physical || output.strategy;
}
