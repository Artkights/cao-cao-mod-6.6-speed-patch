#pragma code_page(65001)
#include <windows.h>
#include "ResourceIds.h"
IDD_FEATURE_SELECT DIALOGEX 0, 0, 280, 205
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "选择补丁功能"
FONT 9, "Microsoft YaHei UI", 400, 0, 134
BEGIN
    CONTROL "安装 / 更新", IDC_FEATURE_INSTALL_ACTION, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 12, 10, 110, 16
    CONTROL "卸载", IDC_FEATURE_UNINSTALL_ACTION, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 152, 10, 100, 16
    LTEXT "请选择功能：", -1, 12, 34, 250, 14
    CONTROL "加速（含齿轮模块）", IDC_FEATURE_ACCELERATOR, "Button", BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 22, 54, 240, 16
    CONTROL "简易攻略", IDC_FEATURE_GUIDE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 77, 240, 16
    CONTROL "战场统计", IDC_FEATURE_BATTLE_STATS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 22, 100, 240, 16
    LTEXT "", IDC_FEATURE_NOTE, 12, 126, 256, 45
    DEFPUSHBUTTON "安装", IDOK, 92, 176, 105, 20
    PUSHBUTTON "取消", IDCANCEL, 205, 176, 63, 20
END
